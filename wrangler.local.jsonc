{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "braimaru-web-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "vars": {
    "BRAIMARU_RESOURCE_MODE": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "braimaru-db-local",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "braimaru-media-local"
    }
  ]
}
