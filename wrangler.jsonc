{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "braimaru",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BRAIMARU_RESOURCE_MODE": "development"
  }
}
